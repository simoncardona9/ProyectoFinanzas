# Copy this file to .env before starting Docker Compose. Do not commit .env.
POSTGRES_DB=finanzas_dev
POSTGRES_USER=finanzas_app
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# Local-only test account created or updated on every `docker compose up`.
# Do not reuse a real email address or password.
TEST_USER_EMAIL=tester@example.test
TEST_USER_PASSWORD=replace-with-a-local-test-password
TEST_HOUSEHOLD_NAME=Test household

# Public HTTPS address. Use a DNS name for a trusted public certificate, or the
# Windows machine's LAN IP for Caddy's local certificate authority.
APP_DOMAIN=localhost

# Optional host ports for the HTTPS reverse proxy. PostgreSQL and the web
# application itself remain internal to Compose.
HTTP_PORT=80
HTTPS_PORT=443
